    "name": "IISIK - GraphQL Dynamic Pricing (ЛР3)",
    "description": "Лабораторная работа 3: базовая структура системы, внутренние сервисы и GraphQL Query API.\n\nДемонстрирует:\n- получение объекта по идентификатору;\n- получение списков объектов;\n- получение связанных данных (вложенный товар в рекомендации — gateway обращается к product-сервису через mock-клиент);\n- агрегирующие Query;\n- базовую обработку ошибок (NOT_FOUND, INVALID_ID).\n\nПодготовка к прогону:\n- mock-режим (заглушки вместо gRPC/HTTP): `python scripts/run_all.py --mode mock`\n- http-режим: `python scripts/seed_all.py`, затем `python scripts/run_all.py --mode http`\n\nВсе запросы — только на чтение (Query), порядок выполнения не важен.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Query — объект по идентификатору",
      "item": [
        {
          "name": "product по id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('нет ошибок GraphQL', () => pm.expect(body.errors).to.be.undefined);",
                  "const p = body.data.product;",
                  "pm.test('id совпадает', () => pm.expect(p.id).to.eql(pm.collectionVariables.get('product1_id')));",
                  "pm.test('Смартфон X200', () => pm.expect(p.name).to.eql('Смартфон X200'));",
                  "pm.test('категория Электроника', () => pm.expect(p.category).to.eql('Электроника'));",
                  "pm.test('текущая цена 1299', () => pm.expect(p.currentPrice).to.eql(1299));",
                  "pm.test('себестоимость 60% = 779.4', () => pm.expect(p.costPrice).to.eql(779.4));",
                  "pm.test('товар активен', () => pm.expect(p.isActive).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query { product(id: \"{{product1_id}}\") { id name description category currentPrice costPrice isActive } }"
              }
            },
            "url": { "raw": "{{base_url}}", "host": ["{{base_url}}"] }
          }
        },
        {
          "name": "priceRecommendation по id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('нет ошибок GraphQL', () => pm.expect(body.errors).to.be.undefined);",
                  "const r = body.data.priceRecommendation;",
                  "pm.test('id совпадает', () => pm.expect(r.id).to.eql(pm.collectionVariables.get('rec1_id')));",
                  "pm.test('статус NEW', () => pm.expect(r.status).to.eql('NEW'));",
                  "pm.test('текущая цена 1299', () => pm.expect(r.currentPrice).to.eql(1299));",
                  "pm.test('рекомендуемая цена 1249', () => pm.expect(r.recommendedPrice).to.eql(1249));",
                  "pm.test('обоснование заполнено', () => pm.expect(r.rationale).to.be.a('string').and.to.have.lengthOf.above(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query { priceRecommendation(id: \"{{rec1_id}}\") { id productId currentPrice recommendedPrice status rationale createdAt } }"
              }
            },
            "url": { "raw": "{{base_url}}", "host": ["{{base_url}}"] }
          }
        }
      ]
