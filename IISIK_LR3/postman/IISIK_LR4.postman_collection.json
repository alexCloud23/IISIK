      "name": "1. Queries — фильтрация",
      "item": [
        {
          "name": "products по категории",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('нет ошибок GraphQL', () => pm.expect(body.errors).to.be.undefined);",
                  "const items = body.data.products;",
                  "pm.test('3 товара категории Электроника', () => pm.expect(items).to.have.length(3));",
                  "pm.test('все из категории Электроника', () => {",
                  "    items.forEach(item => pm.expect(item.category).to.eql('Электроника'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query { products(category: \"Электроника\") { id name category currentPrice isActive } }"
              }
            },
            "url": { "raw": "{{base_url}}", "host": ["{{base_url}}"] }
